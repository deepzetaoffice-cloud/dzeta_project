# Normalise line endings so AI edits on Windows don't create whole-file diffs.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# The owner's white-background logos (C78): locked, kept byte for byte, never normalised
src/brand/white-bg/*.svg -text

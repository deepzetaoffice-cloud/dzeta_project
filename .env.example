# deepzeta website: environment variables (names only, NEVER real values)
#
# How this works
# - This file is committed. It tells developers and Claude Code WHICH variables exist.
# - Real values go in `.env.local` on your machine (git-ignored; Claude Code is blocked
#   from reading it) and in Vercel → Project → Settings → Environment Variables.
#   From P0 on, `vercel env pull .env.local` copies them down.
# - Every variable is validated at startup by `src/lib/env.ts` (built in P0). A missing or
#   malformed required value stops the build with a clear message.
# - Rule: env vars hold SECRETS and values that differ PER ENVIRONMENT only. Business facts
#   (name, phone, WhatsApp, social links, Cal.com link) live in one typed site config built from
#   `docs/facts/company-facts.md`, not here (docs/ai/02 §2.5, 08 §3).
# - Third-party marketing credentials (Meta, LinkedIn, WhatsApp, Gmail, Google Sheets) live in
#   n8n's encrypted Credentials, NOT in the website (decision 0004). Fewer secrets here.
# - Exact names that a library reads by default are marked "verify in P0".

# ---------------------------------------------------------------------------
# Public values (NEXT_PUBLIC_*: bundled into the browser; never put a secret here)
# ---------------------------------------------------------------------------

# The site's own origin: the ONE input for canonicals, hreflang, schema @ids, the sitemap,
# robots and llms files. No trailing slash.
#   .env.local (your machine):  http://localhost:3000
#   Vercel Production + Preview: https://deepzeta.ai   (decision 0006; previews are noindex anyway,
#                                so their canonicals still point at the real site)
# Startup validation fails if it is missing or has a trailing slash; on VERCEL_ENV=production it
# must also be https and must not be a *.vercel.app host.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (GTM-XXXXXXX). The only tag loader (docs/ai/09 §2).
NEXT_PUBLIC_GTM_ID=
# Optional: a GTM "Environment" for previews, so test traffic never pollutes live data.
# GTM → Admin → Environments → the snippet's gtm_auth / gtm_preview values. Leave empty in production.
NEXT_PUBLIC_GTM_AUTH=
NEXT_PUBLIC_GTM_PREVIEW=

# Cloudflare Turnstile site key (spam protection widget on forms and tools).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-only settings (not secret, never sent to the browser)
# ---------------------------------------------------------------------------

# Search indexing switch: "on" or "off"; unset means off (decision 0013).
#   Vercel Production: leave UNSET until launch; set to "on" at launch (P10). This is the
#                      pre-launch lock: until then the live site sends noindex, so search engines
#                      keep the half-built site out of their results.
#   Vercel Preview:    leave unset. Previews are never indexable, whatever this says.
#   .env.local and CI: "on", so Lighthouse's SEO audit sees an indexable page.
SITE_INDEXING=

# ---------------------------------------------------------------------------
# Server-only secrets (never exposed to the browser)
# ---------------------------------------------------------------------------

# Cloudflare Turnstile secret, used by the server to verify form tokens (siteverify).
TURNSTILE_SECRET_KEY=

# n8n: the website calls n8n only from the server (docs/owner/n8n-setup-guide.md, Part 8).
# The Production URL of the "DZ · Lead Intake" webhook (use the Test URL only on your machine).
N8N_LEAD_WEBHOOK_URL=
# The shared secret sent as the X-DZ-Secret header (48+ random characters; same value as n8n credential C3).
N8N_WEBHOOK_SECRET=

# Upstash Redis REST: serverless-safe rate limiting for forms and tools (decision 0004).
# Default names read by @upstash/redis Redis.fromEnv(): verify in P0.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key: the AI agent demo and the Social Media Content Planner (AI SDK + Claude).
# Default name read by the AI SDK Anthropic provider: verify in P0. Set a spending limit in the Anthropic console.
ANTHROPIC_API_KEY=

# Google PageSpeed Insights API key: the "Website & AI Search Health Check" tool (server-side calls only).
# Google Cloud console → APIs & Services → enable "PageSpeed Insights API" → Credentials → API key,
# restricted to that one API.
GOOGLE_PAGESPEED_API_KEY=

# ---------------------------------------------------------------------------
# Set automatically by Vercel: do NOT define these yourself
# ---------------------------------------------------------------------------
# VERCEL_ENV   "production" | "preview" | "development". Anything except production is served
#              with `X-Robots-Tag: noindex` and a disallow-all robots.txt, so preview URLs can
#              never be indexed or leak into canonicals.
# VERCEL_URL   Deployment hostname. Never used for canonicals, the sitemap or schema.
